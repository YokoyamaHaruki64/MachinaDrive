version: 1
name: Player
gameObjects:
  - id: 1
    name: Player
    prefab:
    parent:
    components:
      - type: Transform
        fields:
          m_localPosition: [0, 0, 0]
          m_localRotation: [0, 0, 0, 1]
          m_localScale: [1, 1, 1]
      - type: ModelRenderer
        fields:
          m_drawLayer: 0
          renderPhase: 1
          billboardType: 0
          m_modelPath: Assets/Local/Models/Player.obj
          m_materialPaths: []
          m_inverseAxisFlags: 0
      - type: Player
        fields:
          m_velocity: [0, 0, 0]
          m_isGrounded: false
      - type: Audio
        fields:
          m_filePath: Assets/Local/Sounds/wan.wav
          m_playOnStart: false
          m_loop: false
