version: 1
name: Player
gameObjects:
  - id: 4
    name: Player
    tag: Player
    active: true
    prefab: 
    parent: 
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [0,0,2.61216004e-15]
          m_localRotation: [-0,0,-0,1]
          m_localScale: [1.00034523,1,1.00034523]
      - type: ModelRenderer
        fields:
          enabled: true
          m_drawLayer: 0
          renderPhase: 1
          billboardType: 0
          m_modelPath: Assets/Local/Models/Player.obj
          m_materialPaths:
            - ''
            - Assets/Materials/Player/PlayerBody.material
            - Assets/Materials/Player/PlayerFlont.material
            - Assets/Materials/Player/PlayerHead.material
          m_inverseAxisFlags: 0
      - type: CapsuleCollider
        fields:
          enabled: true
          m_center: [0,1,0]
          m_isTrigger: false
          m_layer: 1
          m_radius: 0.5
          m_height: 2
      - type: Player
        fields:
          enabled: true
          m_speed: 100
          m_attackTime: 5
          m_speedFriction: 0.300000012
          m_debug: true
      - type: Audio
        fields:
          enabled: true
          m_filePath: Assets/Local/Sounds/wan.wav
          m_playOnStart: false
          m_loop: false
      - type: Rigidbody
        fields:
          enabled: true
          m_motionType: 2
          m_mass: 1
          m_bounciness: 1
          m_friction: 0
          m_useGravity: true
          m_allowSleep: true
          m_freezeRotation: true
  - id: 39
    name: PlayerHit
    tag: 
    active: true
    prefab: 
    parent: 4
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [0,0,-2.61125858e-15]
          m_localRotation: [-0,0,-0,1]
          m_localScale: [0.999654889,1,0.999654889]
      - type: SphereCollider
        fields:
          enabled: true
          m_center: [0,1,0]
          m_isTrigger: true
          m_layer: 4
          m_radius: 1.20000005
      - type: PlayerHit
        fields:
          enabled: true
          m_shakeDuration: 0.800000012
          m_shakeMagnitude: 3
