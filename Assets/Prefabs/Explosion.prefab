version: 1
name: Explosion
gameObjects:
  - id: 1
    name: Explosion
    prefab:
    parent:
    components:
      - type: Transform
        fields:
          m_localPosition: [0, 0, 0]
          m_localRotation: [0, 0, 0, 1]
          m_localScale: [1, 1, 1]
      - type: ModelRenderer
        fields:
          m_drawLayer: 0
          renderPhase: 2
          billboardType: 1
          m_modelPath: __primitive_quad
          m_materialPaths:
            - Assets/Materials/Explosion.material
          m_inverseAxisFlags: 0
      - type: ExplosionEffect
        fields: {}
