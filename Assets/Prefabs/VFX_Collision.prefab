version: 1
name: VFX Collision
gameObjects:
  - id: 1
    name: VFX_Collision
    tag: VFXCollision
    active: true
    prefab:
    parent:
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [0, 0, 0]
          m_localRotation: [0, 0, 0, 1]
          m_localScale: [1, 1, 1]
      - type: CollisionVfx
        fields:
          enabled: true
          m_lifetime: 0.8
          m_coneAngle: 38
          m_burstTime: 0.1
          m_burstCount: 20
          m_maxParticles: 64
          m_particleLifetimeMin: 0.3
          m_particleLifetimeMax: 0.6
          m_speedMin: 30
          m_speedMax: 60
          m_gravity: [0, 6, 0]
          m_drag: 0.8
          m_particleSize: [5, 5, 5]
  - id: 2
    name: Collision_Player_Yellow
    tag:
    active: true
    prefab:
    parent: 1
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [0, 0, 0]
          m_localRotation: [0, 0, 0, 1]
          m_localScale: [1, 1, 1]
      - type: ParticleEmitter
        fields:
          enabled: true
          offset: [0, 0, 0]
          maxParticles: 64
          burst: true
          burstCount: 0
          burstTime: 0.1
          finishedDestroy: true
          emitRate: 0
          lifetimeMin: 0.3
          lifetimeMax: 0.6
          gravity: [0, 6, 0]
          drag: 0.8
          size: [5, 5, 5]
          randomizeSpeed: true
          speed: 5
          speedMin: 30
          speedMax: 60
          direction: [0, 1, 0]
          coneAngle: 38
          spawnRadius: 0
          spawnNormal: [0, 1, 0]
          velocityType: 2
          spawnType: 0
      - type: ParticleRenderer
        fields:
          enabled: true
          m_drawLayer: 0
          renderPhase: 2
          billboardType: 1
          m_materialPath: Assets/Materials/VFX/CollisionSpark.material
