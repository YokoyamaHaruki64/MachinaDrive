version: 1
name: Enemy
gameObjects:
  - id: 1
    name: Enemy
    prefab:
    parent:
    components:
      - type: Transform
        fields:
          m_localPosition: [0, 0, 0]
          m_localRotation: [0, 0, 0, 1]
          m_localScale: [1, 1, 1]
      - type: ModelRenderer
        fields:
          m_drawLayer: 0
          renderPhase: 1
          billboardType: 0
          m_modelPath: Assets/Local/Models/Player.obj
          m_materialPaths: []
          m_inverseAxisFlags: 0
      - type: CapsuleCollider
        fields:
          enabled: true
          m_center: [0,1,0]
          m_radius: 0.5
          m_height: 2
      - type: Enemy
        fields: {}
