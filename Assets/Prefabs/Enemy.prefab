version: 1
name: BasicEnemy
gameObjects:
  - id: 5
    name: BasicEnemy
    tag: Enemy
    active: true
    prefab: 
    parent: 
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [0,0,0]
          m_localRotation: [0,1,0,-1.19209304e-07]
          m_localScale: [1,1,1]
      - type: ModelRenderer
        fields:
          enabled: true
          m_drawLayer: 0
          renderPhase: 1
          billboardType: 0
          m_modelPath: Assets/Local/Models/Player.obj
          m_materialPaths:
            - ''
            - ''
            - ''
            - ''
          m_inverseAxisFlags: 0
      - type: CapsuleCollider
        fields:
          enabled: true
          m_center: [0,1,0]
          m_isTrigger: false
          m_layer: 2
          m_radius: 0.5
          m_height: 2
      - type: Rigidbody
        fields:
          enabled: true
          m_motionType: 1
          m_mass: 1
          m_bounciness: 0
          m_friction: 0
          m_useGravity: false
          m_allowSleep: false
          m_freezeRotation: true
      - type: Health
        fields:
          enabled: true
          m_maxHP: 1
      - type: BasicEnemy
        fields:
          enabled: true
          m_moveSpeed: 4
          m_chaseRange: 12
          m_attackRange: 10
          m_shootCooldown: 1.5
          m_turnInterval: 1
          m_randomTurnAngle: 60
          m_projectileSpeed: 30
          m_preferredDistance: 3
          m_chasePlayer: true
          m_teleportNearPlayer: false
          m_teleportInterval: 3
          m_teleportDistance: 8
          m_bulletPrefab: Assets/Prefabs/Bullet.prefab
