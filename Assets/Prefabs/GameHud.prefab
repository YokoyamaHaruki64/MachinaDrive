version: 1
name: GameHud
gameObjects:
  - id: 100
    name: GameHUD
    tag: 
    active: true
    prefab: 
    parent: 
    components:
      - type: UITransform
        fields:
          enabled: true
          m_anchor: [0.5,0.5]
          m_pivot: [0.5,0.5]
          m_stretch: [1,1]
          m_pos: [0,0]
          m_offset: [0,0]
          m_uiRotation: 0
          m_uiScale: [1,1]
          m_aspectRatio: 0
      - type: UICanvas
        fields:
          enabled: true
      - type: GameHud
        fields:
          enabled: true
          m_healthBar: 203
          m_timerText: 205
          m_waveNumber: 249
          m_enemyNumber: 250
          m_comboUIObject: 259
          m_shardsNumber: 
          m_healthRoot: 200
          m_waveRoot: 210
          m_comboRoot: 259
          m_driveRoot: 220
          m_shardsRoot: 
          m_driveGauge: 223
          m_driveChargingText: 225
          m_driveReadyText: 226
          m_visible: true
          m_comboVisible: true
  - id: 259
    name: HUD_Combo
    tag: 
    active: true
    prefab: 
    parent: 100
    components:
      - type: UITransform
        fields:
          enabled: true
          m_anchor: [1,0.5]
          m_pivot: [1,0.5]
          m_stretch: [0.0520833321,0.0925925896]
          m_pos: [-0.119999997,-0.289999992]
          m_offset: [0,0]
          m_uiRotation: 0
          m_uiScale: [1,1]
          m_aspectRatio: 0
      - type: ComboUI
        fields:
          enabled: true
          m_comboValue: 261
          m_comboLabel: 260
          m_boundTime: 0.319999993
          m_boundScale: 0.5
          m_gap: 100
          m_boundCurve:
            - time: 0
              value: 0
              inControl: 0
              outControl: 0.533333302
            - time: 0.5
              value: 1
              inControl: 1
              outControl: 1
            - time: 1
              value: 0
              inControl: 0
              outControl: 0
