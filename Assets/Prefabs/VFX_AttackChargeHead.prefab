version: 1
name: VFX Attack Charge Head
gameObjects:
  - id: 1
    name: VFX_AttackChargeHead
    tag: AttackChargeHead
    active: true
    prefab:
    parent:
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [0, 0, 0]
          m_localRotation: [0, 0, 0, 1]
          m_localScale: [0.35, 0.35, 0.35]
      - type: ModelRenderer
        fields:
          enabled: true
          m_drawLayer: 0
          renderPhase: 2
          billboardType: 1
          m_modelPath: __primitive_quad
          m_materialPaths:
            - Assets/Materials/VFX/AttackChargeHead.material
          m_inverseAxisFlags: 0
      - type: TrailRenderer
        fields:
          enabled: true
          m_drawLayer: 0
