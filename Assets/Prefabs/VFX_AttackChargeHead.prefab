          m_trailLifetime: 0.24
          m_minSegmentDistance: 0.08
          m_width: 0.18
          faceMode: 0
      - type: AttackChargeHead
        fields:
          enabled: true
          m_initialSpeed: 0.8
          m_acceleration: 8
          m_arrivalDistance: 0.18
          m_targetOffset: [0, 0.9, 0]
