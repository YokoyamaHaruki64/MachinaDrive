version: 1
name: HeavyEnemy
gameObjects:
  - id: 7
    name: HeavyEnemy
    tag: Enemy
    active: true
    prefab: 
    parent: 
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [0,0,26.1900005]
          m_localRotation: [0,1,0,-1.19209304e-07]
          m_localScale: [1.70000005,1.70000005,1.70000005]
      - type: Rigidbody
        fields:
          enabled: true
          m_motionType: 1
          m_mass: 1
          m_bounciness: 0
          m_friction: 0
          m_useGravity: false
          m_allowSleep: false
          m_freezeRotation: true
      - type: Health
        fields:
          enabled: true
          m_maxHP: 3
      - type: HeavyEnemy
        fields:
          enabled: true
          m_invincibilityDuration: 0.5
          m_timeRecoveryItemPrefab: Assets/Prefabs/TimeRecoveryItem.prefab
          m_enemyDeathVfxPrefab: Assets/Prefabs/VFX_EnemyDeath.prefab
          m_hitShakeDuration: 0.5
          m_hitShakePower: 6
      - type: SphereCollider
        fields:
          enabled: true
          m_center: [0,3.74000001,0]
          m_isTrigger: false
          m_layer: 2
          m_radius: 2.3599999
  - id: 75
    name: Model
    tag: 
    active: true
    prefab: 
    parent: 7
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [-2.65906965e-06,2.18000007,0]
          m_localRotation: [0,0.707106829,0,-0.707106709]
          m_localScale: [0.00499991933,0.00400000112,0.00399993965]
      - type: ModelRenderer
        fields:
          enabled: true
          m_drawLayer: 0
          renderPhase: 1
          billboardType: 0
          m_modelPath: Assets/Local/Models/Drone.fbx
          m_materialPaths:
            - Assets/Materials/Enemy/HeavyDrone_Body.material
            - Assets/Materials/Enemy/HeavyDrone_Line.material
          m_inverseAxisFlags: 0
          m_castShadow: true
          m_receiveShadow: true
      - type: EnemyAnimation
        fields:
          enabled: true
          m_floatHeight: 0.400000006
          m_floatSpeed: 1.5
      - type: ObjectShake
        fields:
          enabled: true
  - id: 77
    name: HeavyEnemy_GroundPulse
    tag:
    active: true
    prefab:
    parent: 7
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [0,0.100000001,0]
          m_localRotation: [0,0,0,1]
          m_localScale: [1,1,1]
      - type: ParticleEmitter
        fields:
          enabled: true
          offset: [0,0,0]
          maxParticles: 3
          burst: false
          burstCount: 0
          burstTime: 0
          finishedDestroy: false
          emitRate: 2
          lifetimeMin: 1.20000005
          lifetimeMax: 1.39999998
          gravity: [0,0,0]
          drag: 0
          size: [4,4,4]
          scaleOverLifetime:
            - time: 0
              value: 0.300000012
              inControl: 0.300000012
              outControl: 0.300000012
            - time: 1
              value: 1.25
              inControl: 1.25
              outControl: 1.25
          colorOverLifetime:
            r:
              - time: 0
                value: 1
                inControl: 1
                outControl: 1
              - time: 1
                value: 0.349999994
                inControl: 0.349999994
                outControl: 0.349999994
            g:
              - time: 0
                value: 0.600000024
                inControl: 0.600000024
                outControl: 0.600000024
              - time: 1
                value: 0.0500000007
                inControl: 0.0500000007
                outControl: 0.0500000007
            b:
              - time: 0
                value: 0.150000006
                inControl: 0.150000006
                outControl: 0.150000006
              - time: 1
                value: 0.0199999996
                inControl: 0.0199999996
                outControl: 0.0199999996
            a:
              - time: 0
                value: 0.5
                inControl: 0.5
                outControl: 0.5
              - time: 1
                value: 0
                inControl: 0
                outControl: 0
          emissionColor: [0.200000003,0.0399999991,0.00999999978,1]
          emissionStrength: 0
          rotationMin: 0
          rotationMax: 0
          angularVelocityMin: 0
          angularVelocityMax: 0
          velocityStretch: 0
          flipbookColumns: 1
          flipbookRows: 1
          flipbookFrameCount: 0
          flipbookFrameRate: 0
          flipbookLoop: false
          flipbookRandomStart: false
          randomizeSpeed: false
          speed: 0
          speedMin: 0
          speedMax: 0
          direction: [0,1,0]
          coneAngle: 0
          spawnRadius: 0
          spawnNormal: [0,1,0]
          velocityType: 0
          spawnType: 0
      - type: ParticleRenderer
        fields:
          enabled: true
          m_drawLayer: 0
          renderPhase: 2
          billboardType: 1
          m_materialPath: Assets/Materials/VFX/Pulse.material
