                inControl: 1
                outControl: 1
              - time: 1
                value: 0.600000024
                inControl: 0.600000024
                outControl: 0.600000024
            b:
              - time: 0
                value: 1
                inControl: 1
                outControl: 1
              - time: 1
                value: 0.899999976
                inControl: 0.899999976
                outControl: 0.899999976
            a:
              - time: 0
