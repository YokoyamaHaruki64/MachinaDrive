version: 1
name: VFX_PlayerLaunch
gameObjects:
  - id: 1
    name: VFX_PlayerLaunch
    tag:
    active: true
    prefab:
    parent:
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [0,0,0]
          m_localRotation: [0,0,0,1]
          m_localScale: [1,1,1]
      - type: VfxLifetime
        fields:
          enabled: true
  - id: 2
    name: PlayerLaunch_Pulse
    tag:
    active: true
    prefab:
    parent: 1
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [0,0.25,0]
          m_localRotation: [0,0,0,1]
          m_localScale: [1,1,1]
      - type: ParticleEmitter
        fields:
          enabled: true
          offset: [0,0,0]
          maxParticles: 1
          burst: true
          burstCount: 1
          burstTime: 0
          finishedDestroy: false
          emitRate: 0
          lifetimeMin: 0.200000003
          lifetimeMax: 0.200000003
          gravity: [0,0,0]
          drag: 0
          size: [5.5,5.5,5.5]
          scaleOverLifetime:
            - time: 0
              value: 0.200000003
              inControl: 0.200000003
              outControl: 0.200000003
            - time: 0.699999988
              value: 1
              inControl: 1
              outControl: 1
            - time: 1
              value: 1.29999995
              inControl: 1.29999995
              outControl: 1.29999995
          colorOverLifetime:
            r:
              - time: 0
                value: 0.699999988
                inControl: 0.699999988
                outControl: 0.699999988
              - time: 1
                value: 0.100000001
                inControl: 0.100000001
                outControl: 0.100000001
            g:
              - time: 0
                value: 1
                inControl: 1
                outControl: 1
              - time: 1
                value: 0.699999988
                inControl: 0.699999988
                outControl: 0.699999988
            b:
              - time: 0
                value: 1
                inControl: 1
                outControl: 1
              - time: 1
                value: 1
                inControl: 1
                outControl: 1
            a:
              - time: 0
                value: 0.899999976
                inControl: 0.899999976
                outControl: 0.899999976
              - time: 1
                value: 0
                inControl: 0
                outControl: 0
          emissionColor: [0.100000001,0.550000012,0.800000012,1]
          emissionStrength: 0
          rotationMin: 0
          rotationMax: 0
          angularVelocityMin: 0
          angularVelocityMax: 0
          velocityStretch: 0
          flipbookColumns: 1
          flipbookRows: 1
          flipbookFrameCount: 0
          flipbookFrameRate: 0
          flipbookLoop: false
          flipbookRandomStart: false
          randomizeSpeed: false
          speed: 0
          speedMin: 0
          speedMax: 0
          direction: [0,1,0]
          coneAngle: 0
          spawnRadius: 0
          spawnNormal: [0,1,0]
          velocityType: 0
          spawnType: 0
      - type: ParticleRenderer
        fields:
          enabled: true
          m_drawLayer: 0
          renderPhase: 2
          billboardType: 1
          m_materialPath: Assets/Materials/VFX/Pulse.material
  - id: 3
    name: PlayerLaunch_Sparks
