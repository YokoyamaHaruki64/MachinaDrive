version: 1
name: PostProcessImpulse_PlayerShot
gameObjects:
  - id: 1
    name: PostProcessImpulse_PlayerShot
    tag: 
    active: true
    prefab: 
    parent: 
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [0,0,0]
          m_localRotation: [0,0,0,1]
          m_localScale: [1,1,1]
      - type: PostProcessImpulsePreset
        fields:
          enabled: true
          m_settings:
            duration: 0.18
            easeType: OutQuad
            targets:
              - postProcessName: RadialBlur
                floats:
                  - name: _Intensity
                    value: 0.35
              - postProcessName: ChromaticAberration
                floats:
                  - name: _Intensity
                    value: 1
              - postProcessName: Bloom
                floats:
                  - name: _Intensity
                    value: 0.2
