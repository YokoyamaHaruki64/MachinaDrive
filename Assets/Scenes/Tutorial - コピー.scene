          m_isTrigger: false
          m_layer: 1
          m_radius: 0.769999981
          m_height: 3.75
      - type: Health
        fields:
          enabled: true
          m_maxHP: 100
      - type: Player
        fields:
          enabled: true
          m_speed: 10
          m_attackTime: 5
          m_attackEndDuration: 0.5
          m_attackCancelEndRate: 0.5
          m_speedFriction: 0.300000012
