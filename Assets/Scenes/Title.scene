version: 1
name: Title
gameObjects:
  - id: 7
    name: Scene Transition
    tag: 
    active: true
    notDestroyBySceneEnd: true
    prefab: 
    parent: 
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [0,0,0]
          m_localRotation: [0,0,0,1]
          m_localScale: [1,1,1]
