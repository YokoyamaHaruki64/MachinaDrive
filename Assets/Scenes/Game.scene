  - id: 35
    name: Wall_Fore
    tag: 
    active: true
    prefab: 
    parent: 
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [0,0,52.5]
          m_localRotation: [-0,0,-0,1]
          m_localScale: [1,1,1]
      - type: BoxCollider
        fields:
          enabled: true
          m_center: [0,0,0]
          m_isTrigger: false
          m_layer: 0
          m_size: [100,10,5]
  - id: 36
    name: Wall_Back
    tag: 
    active: true
    prefab: 
    parent: 
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [0,0,-52.5]
          m_localRotation: [-0,0,-0,1]
          m_localScale: [1,1,1]
      - type: BoxCollider
        fields:
          enabled: true
          m_center: [0,0,0]
          m_isTrigger: false
          m_layer: 0
          m_size: [100,10,5]
  - id: 39
    name: PlayerHit
    tag: 
    active: true
    prefab: Assets/Prefabs/Player.prefab
    parent: 4
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [0,0,-2.61125858e-15]
          m_localRotation: [-0,0,-0,1]
          m_localScale: [0.999654889,1,0.999654889]
      - type: SphereCollider
        fields:
          enabled: true
          m_center: [0,1,0]
          m_isTrigger: true
          m_layer: 4
          m_radius: 1.20000005
      - type: PlayerHit
        fields:
          enabled: true
          m_shakeDuration: 0.800000012
          m_shakeMagnitude: 3
          m_hitStopDuration: 0.300000012
  - id: 44
    name: Canvas
    tag: 
    active: true
    prefab: 
    parent: 
    components:
      - type: UITransform
        fields:
          enabled: true
          m_anchor: [0.5,0.5]
          m_pivot: [0.5,0.5]
          m_stretch: [0.0520833321,0.0925925896]
          m_pos: [0,0]
          m_offset: [0,0]
          m_uiRotation: 0
          m_uiScale: [1,1]
          m_aspectRatio: 0
      - type: UICanvas
        fields:
          enabled: true
  - id: 45
    name: Combo
    tag: 
    active: true
    prefab: 
    parent: 44
    components:
      - type: UITransform
        fields:
          enabled: true
          m_anchor: [1,0]
          m_pivot: [0.5,0.5]
          m_stretch: [0,0]
          m_pos: [-0.230000004,0.140000001]
          m_offset: [0,0]
          m_uiRotation: 0
          m_uiScale: [1,1]
          m_aspectRatio: 0
      - type: UIText
        fields:
          enabled: true
          m_drawLayer: 0
          font: Assets/Local/Font/AprilGothicOne-R.fnt
          text: 1 Combo!
          m_fontSize: 100
          m_color: [1,0,0,1]
          m_materialPath: Assets/Materials/UI.material
  - id: 50
    name: HPBar
    tag: 
    active: true
    prefab: 
    parent: 44
    components:
      - type: UITransform
        fields:
          enabled: true
          m_anchor: [0,0]
          m_pivot: [0,0.5]
          m_stretch: [0.379999995,0.0299999993]
          m_pos: [0.0399999991,0.0799999982]
          m_offset: [0,0]
          m_uiRotation: 0
          m_uiScale: [1,1]
          m_aspectRatio: 0
      - type: UIImage
        fields:
          enabled: true
          m_drawLayer: 0
          image: ''
          m_color: [1,1,1,1]
          m_raycastTarget: true
          m_dragEnabled: false
          m_materialPath: Assets/Materials/FillBar.material
      - type: FillBar
        fields:
          enabled: true
          m_max: 100
          m_current: 100
          m_barColor: [1,1,1,1]
          m_chipColor: [1,0.200000003,0.200000003,1]
          m_chipDecreaseSpeed: 10
          m_chipDecreaseDelay: 0.5
          m_verticalFill: false
          m_horizontalFill: true
          m_verticalFromTop: false
          m_verticalFromCenter: false
          m_verticalFromBottom: false
          m_horizontalFromLeft: true
          m_horizontalFromCenter: false
          m_horizontalFromRight: false
