    parent: 
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [5,3.5,12]
          m_localRotation: [-0,0,-0,1]
          m_localScale: [5,5,5]
      - type: ModelRenderer
        fields:
          enabled: true
          m_drawLayer: 0
          renderPhase: 2
          billboardType: 2
          m_modelPath: __primitive_quad
          m_materialPaths:
            - Assets/Materials/Tree.material
          m_inverseAxisFlags: 0
  - id: 9
    name: Tree(Instance)
    tag: 
    active: true
    prefab: Assets/Prefabs/Tree.prefab
    parent: 
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [-5,3.5,12]
          m_localRotation: [-0,0,-0,1]
          m_localScale: [5,5,5]
      - type: ModelRenderer
        fields:
