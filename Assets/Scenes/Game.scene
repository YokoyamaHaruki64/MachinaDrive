          m_drawLayer: 0
          renderPhase: 2
          billboardType: 2
          m_modelPath: __primitive_quad
          m_materialPaths:
            - Assets/Materials/Tree.material
          m_inverseAxisFlags: 0
  - id: 10
    name: Tree(Instance)
    tag: 
    active: true
    prefab: Assets/Prefabs/Tree.prefab
    parent: 
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [7,3.5,8]
          m_localRotation: [-0,0,-0,1]
          m_localScale: [5,5,5]
      - type: ModelRenderer
        fields:
          enabled: true
          m_drawLayer: 0
          renderPhase: 2
          billboardType: 2
          m_modelPath: __primitive_quad
          m_materialPaths:
            - Assets/Materials/Tree.material
          m_inverseAxisFlags: 0
  - id: 11
    name: Tree(Instance)
    tag: 
    active: true
    prefab: Assets/Prefabs/Tree.prefab
    parent: 
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [-7,3.5,8]
          m_localRotation: [-0,0,-0,1]
          m_localScale: [5,5,5]
      - type: ModelRenderer
        fields:
          enabled: true
          m_drawLayer: 0
          renderPhase: 2
          billboardType: 2
          m_modelPath: __primitive_quad
          m_materialPaths:
            - Assets/Materials/Tree.material
          m_inverseAxisFlags: 0
  - id: 12
    name: Skydome
    tag: 
    active: true
    prefab: 
    parent: 
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [0,0,0]
          m_localRotation: [-0,0,-0,1]
          m_localScale: [1000,1000,1000]
      - type: Skydome
        fields:
          enabled: true
      - type: ModelRenderer
        fields:
          enabled: true
          m_drawLayer: 0
          renderPhase: 1
          billboardType: 0
          m_modelPath: Assets/Local/Models/sky.obj
          m_materialPaths:
            - ''
            - Assets/Materials/Skydome.material
          m_inverseAxisFlags: 0
  - id: 13
    name: Score
