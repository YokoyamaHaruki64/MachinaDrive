version: 1
name: Game
gameObjects:
  - id: 1
    name: Camera
    tag: 
    active: true
    prefab: 
    parent: 
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [0,2,-10]
          m_localRotation: [-0,0,-0,1]
          m_localScale: [0.999995232,1,0.999995232]
      - type: Camera
        fields:
          enabled: true
          m_target: [0,0,2.61216004e-15]
          m_up: [0,1,0]
      - type: CameraController
        fields:
          enabled: true
          m_distance: 10
          m_sensitivity: 0.00100000005
          m_offset: [0,1,0]
  - id: 2
    name: Field
    tag: 
    active: true
    prefab: 
    parent: 
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [0,0,0]
          m_localRotation: [0,0,0,1]
          m_localScale: [10,1,10]
      - type: ModelRenderer
        fields:
          enabled: true
          m_drawLayer: 0
          renderPhase: 1
          billboardType: 0
          m_modelPath: __primitive_plane
          m_materialPaths:
            - Assets/Materials/Field.material
          m_inverseAxisFlags: 0
      - type: BoxCollider
        fields:
          enabled: true
          m_center: [0,-0.5,0]
          m_isTrigger: false
          m_layer: 0
          m_size: [10,1,10]
  - id: 3
    name: MateoCube
    tag: 
    active: true
    prefab: 
    parent: 
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [0,1,-5]
          m_localRotation: [-0.0682410151,-0.0643375218,-0.0641507059,0.9935233]
          m_localScale: [1.00055456,1.00062096,1.00062978]
      - type: ModelRenderer
        fields:
          enabled: true
          m_drawLayer: 0
          renderPhase: 1
          billboardType: 0
          m_modelPath: __primitive_cube
          m_materialPaths:
            - Assets/Materials/Mateo.material
          m_inverseAxisFlags: 0
      - type: RotateCube
        fields:
          enabled: true
  - id: 4
    name: Player
    tag: Player
    active: true
    prefab: Assets/Prefabs/Player.prefab
    parent: 
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [0,0,2.61216004e-15]
          m_localRotation: [-0,0,-0,1]
          m_localScale: [1.00034523,1,1.00034523]
      - type: ModelRenderer
        fields:
          enabled: true
          m_drawLayer: 0
          renderPhase: 1
          billboardType: 0
          m_modelPath: Assets/Local/Models/Player.obj
          m_materialPaths:
            - ''
            - Assets/Materials/Player/PlayerBody.material
            - Assets/Materials/Player/PlayerFlont.material
            - Assets/Materials/Player/PlayerHead.material
          m_inverseAxisFlags: 0
      - type: CapsuleCollider
        fields:
          enabled: true
          m_center: [0,1,0]
          m_isTrigger: false
          m_layer: 1
          m_radius: 0.5
          m_height: 2
      - type: Player
        fields:
          enabled: true
          m_hpBar: 50
          m_speed: 100
          m_attackTime: 5
          m_speedFriction: 0.300000012
          m_debug: true
      - type: Audio
        fields:
          enabled: true
          m_filePath: Assets/Local/Sounds/wan.wav
          m_playOnStart: false
          m_loop: false
      - type: Rigidbody
        fields:
          enabled: true
          m_motionType: 2
          m_mass: 1
          m_bounciness: 1
          m_friction: 0
          m_useGravity: true
          m_allowSleep: true
          m_freezeRotation: true
  - id: 5
    name: Enemy
    tag: Enemy
    active: true
    prefab: Assets/Prefabs/Enemy.prefab
    parent: 
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [4,0,4]
          m_localRotation: [0,1,0,-1.19209304e-07]
          m_localScale: [1,1,1]
      - type: ModelRenderer
        fields:
          enabled: true
          m_drawLayer: 0
          renderPhase: 1
          billboardType: 0
          m_modelPath: Assets/Local/Models/Player.obj
          m_materialPaths:
            - ''
            - ''
            - ''
            - ''
          m_inverseAxisFlags: 0
      - type: CapsuleCollider
        fields:
          enabled: true
          m_center: [0,1,0]
          m_isTrigger: false
          m_layer: 2
          m_radius: 0.5
          m_height: 2
      - type: Enemy
        fields:
          enabled: true
  - id: 6
    name: Enemy
    tag: Enemy
    active: true
    prefab: Assets/Prefabs/Enemy.prefab
    parent: 
