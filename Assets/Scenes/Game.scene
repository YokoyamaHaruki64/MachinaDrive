version: 1
name: Game
gameObjects:
  - id: 1
    name: Camera
    tag: 
    active: true
    prefab: 
    parent: 
    components:
      - type: Transform
        fields:
          enabled: true
          m_localPosition: [0,2,-10]
          m_localRotation: [-0,0,-0,1]
          m_localScale: [0.999995232,1,0.999995232]
      - type: Camera
        fields:
          enabled: true
          m_target: [0,0,2.61216004e-15]
          m_up: [0,1,0]
      - type: CameraController
        fields:
          enabled: true
          m_distance: 10
          m_sensitivity: 0.00100000005
          m_offset: [0,2,0]
          m_collisionPadding: 0.300000012
